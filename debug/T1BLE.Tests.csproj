    <Compile Include="../src/BackgroundAudioRouter.cs" Link="App/BackgroundAudioRouter.cs" />
    <Compile Include="../src/DictationBridge.cs" Link="App/DictationBridge.cs" />
    <Compile Include="../src/VoiceTypingKeyboard.cs" Link="App/VoiceTypingKeyboard.cs" />
    <Compile Include="../src/SearchKeyGuard.cs" Link="App/SearchKeyGuard.cs" />
    <Compile Include="../src/AdpcmDecoder.cs" Link="App/AdpcmDecoder.cs" />
